{
  "name": "wordbox",
  "version": "0.1.0",
  "private": true,
  "description": "WordBox MVP - a lightweight vocabulary learning web app",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"pnpm run dev:web\" \"pnpm run dev:api\"",
    "dev:web": "pnpm --filter @wordbox/web dev",
    "dev:api": "pnpm --filter @wordbox/api start:dev",
    "build": "pnpm run build:web && pnpm run build:api",
    "build:web": "pnpm --filter @wordbox/web build",
    "build:api": "pnpm --filter @wordbox/api build",
    "test": "pnpm run test:web && pnpm run test:api",
    "test:web": "pnpm --filter @wordbox/web test",
    "test:api": "pnpm --filter @wordbox/api test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:generate": "pnpm --filter @wordbox/api swagger:json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.11.0+sha1.4cd20e68438613738e8f2bc9aece61eaa6b3e649"
}
